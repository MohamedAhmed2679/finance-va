<?xml version="1.0" encoding="utf-8"?>
<!-- HTTPS only, and only the phone's built-in certificate authorities: a certificate someone added
     to the phone (to inspect traffic) is not trusted by Zaylo. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
